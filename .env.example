# ============================================================
#  PIXEL ORCA — переменные окружения бэкенда
#  Скопируй в .env и подставь свои значения (для PaaS — в настройках сервиса).
#  Сервер читает ТОЛЬКО окружение, файла .env нет: на Render/Railway/Fly
#  переменные задаются в панели или через fly secrets set / render env.
# ============================================================

# ---- сеть ----
# Порт и хост приходят от платформы автоматически (PORT подставляет Render/Railway/Fly)
PORT=8081
HOST=0.0.0.0

# Публичный адрес сервиса — только для красоты в логах при старте
PUBLIC_URL=https://kosatka.onrender.com

# ---- база данных (главное для PaaS!) ----
# На бесплатных тарифах файловая система эфемерна: после деплоя/рестарта
# аккаунты, кланы и облачные сейвы пропадут. Нужен постоянный диск:
#   Render  → disk, mountPath /data
#   Fly     → fly volumes create kosatka_data, монтирование в /data
#   Railway → volume, монтирование в /data
#   VPS     → любой каталог на диске
DATA_FILE=/data/db.json

# ---- геймплей ----
PVP_MS=30000
RAID_MS=60000
TICK=250
SEASON_MS=2592000000

# ---- статика (необязательно) ----
# Если фронт живёт на GitHub Pages, бэкенду статика не нужна и её можно не отдавать.
# Путь к папке с клиентом внутри контейнера/репозитория:
# STATIC_DIR=/app
#   Docker-образ:        /app
#   Render (из репозитория): /opt/render/project/src/pixel-orca
#   Fly:                 /app
# Если переменная не задана, сервер берёт папку с клиентом рядом с server/.
